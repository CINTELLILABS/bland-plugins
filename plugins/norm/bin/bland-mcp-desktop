#!/usr/bin/env bash
# Launcher so the Claude DESKTOP app — which usually has no `node` on its PATH —
# can run the Bland stdio MCP proxy. Finds a Node.js binary, then execs the proxy
# with stdio passed straight through. Nothing sensitive is passed here: the proxy
# resolves the API key + url itself from ~/.claude/settings.json.
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Prefer an explicit NODE_BIN, then PATH, then common install locations + version managers.
NODE_BIN="${NODE_BIN:-$(command -v node 2>/dev/null || true)}"
if [[ -z "${NODE_BIN:-}" ]]; then
  for candidate in \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    /usr/bin/node \
    "$HOME/.claude/local/node" \
    "$HOME"/.nvm/versions/node/*/bin/node \
    "$HOME"/.volta/bin/node \
    "$HOME"/.fnm/node-versions/*/installation/bin/node \
    "$HOME"/.asdf/installs/nodejs/*/bin/node; do
    if [[ -x "$candidate" ]]; then NODE_BIN="$candidate"; break; fi
  done
fi

if [[ -z "${NODE_BIN:-}" ]]; then
  echo "Bland MCP: could not find a Node.js binary. Install Node 18+ (or set NODE_BIN in the connector config)." >&2
  exit 127
fi

exec "$NODE_BIN" "$PLUGIN_ROOT/bin/bland-mcp-proxy.cjs"
